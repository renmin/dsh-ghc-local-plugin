{
  "name": "@renmin/dsh-llm-ghc-local",
  "version": "0.2.2",
  "description": "Installable DSH bundle that adds a ghc-local LLM provider backed by local GitHub Copilot",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.34"
  }
}
